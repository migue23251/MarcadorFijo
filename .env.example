# MarcadorFijo — environment variable reference
# Copy this file as a reference; set actual values in Replit Secrets / Replit env vars.
# Never commit real secret values.

# ── Required secrets (set via Replit Secrets) ────────────────────────────────

# Clerk authentication (https://clerk.com → API Keys)
CLERK_PUBLISHABLE_KEY=pk_test_...
CLERK_SECRET_KEY=sk_test_...

# Groq AI for match analysis (https://console.groq.com)
GROQ_API_KEY=gsk_...

# Session encryption fallback (any random 32+ char string)
SESSION_SECRET=

# ── Runtime-managed by Replit — DO NOT set manually ──────────────────────────
# DATABASE_URL, PGHOST, PGPORT, PGUSER, PGPASSWORD, PGDATABASE
# REPLIT_DOMAINS, REPLIT_DEV_DOMAIN, REPL_ID, PORT

# ── Non-secret environment variables (set in Replit shared env) ──────────────

BASE_PATH=/
NODE_ENV=development
LOG_LEVEL=info

# ── Optional: football data feeds (improves AI analysis quality) ──────────────

# API-Football (https://www.api-football.com)
API_FOOTBALL_KEY_1=
API_FOOTBALL_KEY_2=

# Alternative football data provider
FOOTBALL_API_KEY=

# The Odds API (https://the-odds-api.com)
ODDS_API_KEY_1=
ODDS_API_KEY_2=
THE_ODDS_API_KEY=

# ── Optional: Google Generative AI (alternative AI provider) ─────────────────
GOOGLE_GENAI_API_KEY=
