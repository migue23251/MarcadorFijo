modules = ["nodejs-20", "web", "bash"]

[deployment]
router = "application"
deploymentTarget = "autoscale"

[deployment.postBuild]
args = ["pnpm", "store", "prune"]
env = { "CI" = "true" }

[workflows]

[agent]
stack = "PNPM_WORKSPACE"
expertMode = true

[postMerge]
path = "scripts/post-merge.sh"
timeoutMs = 20000

[nix]
channel = "stable-25_05"

[userenv]

[userenv.shared]
BASE_PATH = "/"
LOG_LEVEL = "info"
NODE_ENV = "development"
CLERK_PUBLISHABLE_KEY = "pk_test_bGVhcm5pbmctZGlub3NhdXItMzkuY2xlcmsuYWNjb3VudHMuZGV2JA"
